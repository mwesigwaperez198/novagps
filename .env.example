# NOVA_MODE: full = docker/k8s stack (Postgres/Kafka/MQTT) | portable = single process (SQLite + local bus)
NOVA_MODE=full
# DATA_DIR: where portable SQLite data lives (defaults to ./data when unset)
DATA_DIR=
DATABASE_URL=postgresql://nova_admin:strongpassword@postgres:5432/nova_gps
POSTGRES_USER=nova_admin
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=nova_gps
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=nova.locations
MQTT_BROKER=mosquitto:1883
SECRET_KEY=replace_with_secure_random
JWT_ALGORITHM=HS256
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
VAULT_ADDR=
VAULT_TOKEN=
SENTRY_DSN=
LETSENCRYPT_EMAIL=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANDBOX_EXECUTOR_MODE=mock
WS_HOST=0.0.0.0
WS_PORT=8765
RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=120
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8765
